@model IEnumerable<SistemaInventario.ViewModels.CompraListadoViewModel>
@{ ViewData["Title"] = "Compras"; }

<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div><h2>Compras</h2><p>Consulta las compras registradas a proveedores.</p></div>
    <a asp-action="Create" class="btn btn-primary">Registrar compra</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">@mensaje<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>
}

<div class="section-card">
    <form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
        <div class="col-md-9">
            <label for="busqueda" class="form-label">Buscar compra</label>
            <input id="busqueda" name="busqueda" value="@ViewBag.Busqueda" class="form-control" placeholder="Número de factura o proveedor" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-grow-1">Buscar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h5 class="mb-0">Compras registradas</h5>
        <span class="text-muted small">Resultados: @Model.Count()</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>N.º</th><th>Factura</th><th>Fecha</th><th>Proveedor</th><th>Registró</th><th class="text-end">Total</th><th class="text-end">Acciones</th></tr></thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No hay compras registradas.</td></tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>#@item.IdCompra</td>
                        <td>@(item.NumeroFactura ?? "Sin factura")</td>
                        <td>@(item.FechaCompra?.ToString("dd/MM/yyyy HH:mm") ?? "Sin fecha")</td>
                        <td><strong>@item.Proveedor</strong></td>
                        <td>@item.Usuario</td>
                        <td class="text-end">@item.Total.ToString("N2")</td>
                        <td class="text-end"><a asp-action="Details" asp-route-id="@item.IdCompra" class="btn btn-sm btn-outline-primary">Ver detalle</a></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
