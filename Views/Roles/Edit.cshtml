@model SistemaInventario.ViewModels.RolFormViewModel
@{ ViewData["Title"] = "Editar rol"; }

<div class="page-heading"><h2>Editar rol</h2><p>Actualiza el nombre o la descripción del rol.</p></div>
<div class="section-card">
    <form asp-action="Edit" asp-route-id="@Model.IdRol" method="post">
        <input type="hidden" asp-for="IdRol" />
        <partial name="_Formulario" model="Model" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
