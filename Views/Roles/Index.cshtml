@model IEnumerable<SistemaInventario.ViewModels.RolListadoViewModel>
@{ ViewData["Title"] = "Roles"; }
<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-3"><div><h2>Roles</h2><p>Administra los roles del sistema.</p></div><a asp-action="Create" class="btn btn-primary">Nuevo rol</a></div>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-warning">@error</div> }
<div class="section-card">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><h5 class="mb-0">Roles registrados</h5><div class="btn-group btn-group-sm"><a asp-action="Index" asp-route-estado="activos" class="btn btn-outline-secondary">Activos</a><a asp-action="Index" asp-route-estado="inactivos" class="btn btn-outline-secondary">Inactivos</a><a asp-action="Index" asp-route-estado="todos" class="btn btn-outline-secondary">Todos</a></div></div>
    <div class="table-responsive"><table class="table table-hover align-middle"><thead class="table-light"><tr><th>Nombre</th><th>Descripción</th><th>Usuarios</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
    @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted py-4">No hay roles para este filtro.</td></tr> }
    @foreach (var item in Model) { <tr><td>@item.Nombre</td><td>@(item.Descripcion ?? "—")</td><td>@item.UsuariosAsignados</td><td><span class="badge @(item.Activo ? "text-bg-success" : "text-bg-secondary")">@(item.Activo ? "Activo" : "Inactivo")</span></td><td class="text-nowrap"><a asp-action="Details" asp-route-id="@item.IdRol" class="btn btn-sm btn-outline-secondary">Ver</a><a asp-action="Edit" asp-route-id="@item.IdRol" class="btn btn-sm btn-outline-primary">Editar</a>@if (item.Activo) { <a asp-action="Delete" asp-route-id="@item.IdRol" class="btn btn-sm btn-outline-warning">Inhabilitar</a> } else { <form asp-action="Reactivar" asp-route-id="@item.IdRol" method="post" class="d-inline" onsubmit="return confirm('Al activar este rol, sus usuarios activos podrán iniciar sesión con sus permisos actuales. ¿Continuar?')"><button class="btn btn-sm btn-outline-success">Activar nuevamente</button></form> }</td></tr> }
    </tbody></table></div>
</div>
