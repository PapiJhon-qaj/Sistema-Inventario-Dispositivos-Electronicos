@model SistemaInventario.Models.proveedor
@{ ViewData["Title"] = "Editar proveedor"; }

<div class="page-heading">
    <h2>Editar proveedor</h2>
    <p>Actualiza la información del proveedor seleccionado.</p>
</div>
<div class="section-card">
    <form asp-action="Edit" asp-route-id="@Model.idproveedor" method="post">
        <input type="hidden" asp-for="idproveedor" />
        <partial name="_Formulario" model="Model" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>
