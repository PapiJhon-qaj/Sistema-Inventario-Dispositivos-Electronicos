@model SistemaInventario.Models.cliente
@{ ViewData["Title"] = "Editar cliente"; }

<div class="page-heading">
    <h2>Editar cliente</h2>
    <p>Actualiza la información del cliente seleccionado.</p>
</div>
<div class="section-card">
    <form asp-action="Edit" asp-route-id="@Model.idcliente" method="post">
        <input type="hidden" asp-for="idcliente" />
        <partial name="_Formulario" model="Model" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>
