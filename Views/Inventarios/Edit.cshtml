@model SistemaInventario.Models.inventario
@{ ViewData["Title"] = "Editar unidad"; }

<div class="page-heading">
    <h2>Editar unidad de inventario</h2>
    <p>Actualiza los datos y el estado permitido de esta unidad.</p>
</div>
<div class="section-card">
    <form asp-action="Edit" asp-route-id="@Model.idinventario" method="post">
        <input type="hidden" asp-for="idinventario" />
        <partial name="_Formulario" model="Model" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>
