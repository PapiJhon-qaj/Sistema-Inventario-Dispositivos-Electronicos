@model IEnumerable<SistemaInventario.Models.inventario>
@{ ViewData["Title"] = "Inventario"; }

<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div><h2>Inventario</h2><p>Consulta y administra las unidades físicas de tus productos.</p></div>
    <a asp-action="Create" class="btn btn-primary">Registrar unidad</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">@mensaje<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>
}

<div class="section-card">
    <form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
        <div class="col-lg-6">
            <label for="busqueda" class="form-label">Buscar</label>
            <input id="busqueda" name="busqueda" value="@ViewBag.Busqueda" class="form-control" placeholder="Producto, IMEI o número de serie" />
        </div>
        <div class="col-sm-8 col-lg-4">
            <label for="estado" class="form-label">Filtrar por estado</label>
            <select id="estado" name="estado" asp-items="ViewBag.Estados" class="form-select">
                <option value="">Todos los estados</option>
            </select>
        </div>
        <div class="col-sm-4 col-lg-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-grow-1">Buscar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h5 class="mb-0">Unidades registradas</h5>
        <span class="text-muted small">Resultados: @Model.Count()</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>ID</th><th>Producto</th><th>IMEI</th><th>Número de serie</th><th>Fecha de ingreso</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No hay unidades de inventario que coincidan con la búsqueda.</td></tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.idinventario</td>
                        <td><strong>@item.producto_idproductoNavigation.nombre</strong></td>
                        <td>@(item.imei ?? "—")</td>
                        <td>@(item.numero_serie ?? "—")</td>
                        <td>@(item.fecha_ingreso?.ToString("dd/MM/yyyy HH:mm") ?? "Sin fecha")</td>
                        <td><span class="badge @(item.estado == "Disponible" ? "text-bg-success" : item.estado == "Vendido" ? "text-bg-secondary" : item.estado == "Dañado" ? "text-bg-danger" : "text-bg-warning")">@(item.estado ?? "Sin estado")</span></td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.idinventario" class="btn btn-sm btn-outline-primary">Editar</a>
                            @if (item.estado != "Dañado" && item.estado != "Vendido")
                            {
                                <a asp-action="Delete" asp-route-id="@item.idinventario" class="btn btn-sm btn-outline-warning">Marcar dañada</a>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
