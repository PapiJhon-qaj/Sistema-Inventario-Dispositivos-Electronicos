@model IEnumerable<SistemaInventario.ViewModels.UsuarioListadoViewModel>
@{ ViewData["Title"] = "Usuarios"; }
<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-3"><div><h2>Usuarios</h2><p>Administra usuarios, roles y acceso.</p></div><a asp-action="Create" class="btn btn-primary">Nuevo usuario</a></div>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-warning">@error</div> }
<div class="section-card">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><h5 class="mb-0">Usuarios registrados</h5><div class="btn-group btn-group-sm"><a asp-action="Index" asp-route-estado="Activo" class="btn btn-outline-secondary">Activos</a><a asp-action="Index" asp-route-estado="Inactivo" class="btn btn-outline-secondary">Inactivos</a><a asp-action="Index" asp-route-estado="todos" class="btn btn-outline-secondary">Todos</a></div></div>
    <div class="table-responsive"><table class="table table-hover align-middle"><thead class="table-light"><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Estado</th><th>Ventas</th><th>Compras</th><th>Acciones</th></tr></thead><tbody>
    @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">No hay usuarios para este filtro.</td></tr> }
    @foreach (var item in Model) { <tr><td>@item.NombreCompleto</td><td>@item.Correo</td><td>@item.Rol</td><td><span class="badge @(item.Estado == "Activo" ? "text-bg-success" : "text-bg-secondary")">@(item.Estado ?? "Sin estado")</span></td><td>@item.Ventas</td><td>@item.Compras</td><td class="text-nowrap"><a asp-action="Details" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-outline-secondary">Ver</a><a asp-action="Edit" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-outline-primary">Editar</a><form asp-action="CambiarEstado" asp-route-id="@item.IdUsuario" method="post" class="d-inline" onsubmit="return confirm('¿Cambiar el estado de esta cuenta?')"><button class="btn btn-sm @(item.Estado == "Activo" ? "btn-outline-warning" : "btn-outline-success")">@(item.Estado == "Activo" ? "Inhabilitar" : "Activar")</button></form></td></tr> }
    </tbody></table></div>
</div>
