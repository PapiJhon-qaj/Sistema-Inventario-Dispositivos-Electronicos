@model IEnumerable<SistemaInventario.ViewModels.VentaListadoViewModel>
@{ ViewData["Title"] = "Ventas"; }

<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div><h2>Ventas</h2><p>Consulta las ventas y el estado de sus equipos.</p></div>
    <a asp-action="Create" class="btn btn-primary">Registrar venta</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">@mensaje<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>
}

<div class="section-card">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h5 class="mb-0">Historial de ventas</h5>
        <span class="text-muted small">Total: @Model.Count()</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>ID</th><th>Fecha</th><th>Cliente</th><th>Usuario</th><th class="text-end">Total</th><th>Método</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">No hay ventas registradas.</td></tr>
            }
            else
            {
                @foreach (var venta in Model)
                {
                    <tr>
                        <td>#@venta.IdVenta</td>
                        <td>@(venta.FechaVenta?.ToString("dd/MM/yyyy HH:mm") ?? "Sin fecha")</td>
                        <td>@venta.Cliente</td>
                        <td>@venta.Usuario</td>
                        <td class="text-end">@venta.Total.ToString("N2")</td>
                        <td>@(venta.MetodoPago ?? "Sin método")</td>
                        <td><span class="badge @(venta.Estado == "Completada" ? "text-bg-success" : "text-bg-secondary")">@(venta.Estado ?? "Sin estado")</span></td>
                        <td class="text-end"><a asp-action="Details" asp-route-id="@venta.IdVenta" class="btn btn-sm btn-outline-primary">Ver detalle</a></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
