@model SistemaInventario.ViewModels.VentaDetalleViewModel
@{ ViewData["Title"] = $"Venta #{Model.IdVenta}"; }

<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div><h2>Venta #@Model.IdVenta</h2><p>Detalle e historial de los equipos vendidos.</p></div>
    <div class="d-flex gap-2">
        @if (Model.Estado == "Completada")
        {
            <a asp-action="Anular" asp-route-id="@Model.IdVenta" class="btn btn-outline-danger">Anular venta</a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Volver a ventas</a>
    </div>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">@mensaje<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>
}

@if (Model.Estado == "Anulada")
{
    <div class="alert alert-warning">
        La venta está anulada y el historial se conserva. Los equipos volvieron a estado Disponible, pero el índice UNIQUE de detalle_venta.inventario_idinventario impide asociarlos a una nueva venta mientras se conserve este detalle histórico. No se pueden revender sin cambiar el diseño de datos.
    </div>
}

<div class="section-card mt-0">
    <div class="row">
        <div class="col-md-6"><dl class="row mb-0">
            <dt class="col-sm-4">Fecha</dt><dd class="col-sm-8">@(Model.FechaVenta?.ToString("dd/MM/yyyy HH:mm") ?? "Sin fecha")</dd>
            <dt class="col-sm-4">Cliente</dt><dd class="col-sm-8">@Model.Cliente</dd>
            <dt class="col-sm-4">Usuario</dt><dd class="col-sm-8">@Model.Usuario</dd>
        </dl></div>
        <div class="col-md-6"><dl class="row mb-0">
            <dt class="col-sm-4">Método de pago</dt><dd class="col-sm-8">@(Model.MetodoPago ?? "Sin método")</dd>
            <dt class="col-sm-4">Estado</dt><dd class="col-sm-8"><span class="badge @(Model.Estado == "Completada" ? "text-bg-success" : "text-bg-secondary")">@(Model.Estado ?? "Sin estado")</span></dd>
            <dt class="col-sm-4">Total</dt><dd class="col-sm-8"><strong>@Model.Total.ToString("N2")</strong></dd>
        </dl></div>
    </div>
</div>

<div class="section-card">
    <h5>Equipos de la venta</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Producto</th><th>Equipo</th><th>IMEI</th><th>Número de serie</th><th class="text-end">Precio unitario</th><th class="text-end">Cantidad</th><th class="text-end">Subtotal</th></tr></thead>
            <tbody>
            @if (Model.Detalles.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-4">Esta venta no tiene detalles registrados.</td></tr>
            }
            else
            {
                @foreach (var detalle in Model.Detalles)
                {
                    <tr>
                        <td><strong>@detalle.Producto</strong></td>
                        <td>#@detalle.IdInventario</td>
                        <td>@(detalle.Imei ?? "—")</td>
                        <td>@(detalle.NumeroSerie ?? "—")</td>
                        <td class="text-end">@detalle.PrecioUnitario.ToString("N2")</td>
                        <td class="text-end">@detalle.Cantidad</td>
                        <td class="text-end">@detalle.Subtotal.ToString("N2")</td>
                    </tr>
                }
            }
            </tbody>
            <tfoot><tr><th colspan="6" class="text-end">Total de la venta</th><th class="text-end">@Model.Total.ToString("N2")</th></tr></tfoot>
        </table>
    </div>
</div>
