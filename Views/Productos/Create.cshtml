@model SistemaInventario.Models.producto
@{ ViewData["Title"] = "Nuevo producto"; }

<div class="page-heading">
    <h2>Nuevo producto</h2>
    <p>Completa los datos del producto y asígnale una categoría.</p>
</div>

<div class="section-card">
    <form asp-action="Create" method="post">
        <partial name="_Formulario" model="Model" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary" disabled="@(ViewBag.HayCategorias == false)">Guardar producto</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
