@model IEnumerable<SistemaInventario.Models.producto>
@{ ViewData["Title"] = "Productos"; }

<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div><h2>Productos</h2><p>Administra el catálogo de productos de la tienda.</p></div>
    <a asp-action="Create" class="btn btn-primary">Nuevo producto</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">@mensaje<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>
}

<div class="section-card">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h5 class="mb-0">Listado de productos</h5>
        <div class="d-flex gap-2 align-items-center">
            <form asp-action="Index" method="get" class="d-flex gap-2 align-items-end flex-wrap">
                <input type="hidden" name="estado" value="@ViewBag.EstadoFiltro" />
                <div>
                    <label for="ordenarPor" class="form-label small mb-1">Ordenar por</label>
                    <select id="ordenarPor" name="ordenarPor" class="form-select form-select-sm">
                        <option value="nombre" selected="@(ViewBag.OrdenarPor == "nombre")">Nombre</option>
                        <option value="id" selected="@(ViewBag.OrdenarPor == "id")">ID</option>
                        <option value="marca" selected="@(ViewBag.OrdenarPor == "marca")">Marca</option>
                        <option value="modelo" selected="@(ViewBag.OrdenarPor == "modelo")">Modelo</option>
                        <option value="categoria" selected="@(ViewBag.OrdenarPor == "categoria")">Categoría</option>
                        <option value="precio" selected="@(ViewBag.OrdenarPor == "precio")">Precio</option>
                        <option value="stock" selected="@(ViewBag.OrdenarPor == "stock")">Stock mínimo</option>
                    </select>
                </div>
                <div>
                    <label for="direccion" class="form-label small mb-1">Dirección</label>
                    <select id="direccion" name="direccion" class="form-select form-select-sm">
                        <option value="asc" selected="@(ViewBag.Direccion == "asc")">Ascendente</option>
                        <option value="desc" selected="@(ViewBag.Direccion == "desc")">Descendente</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-sm btn-primary">Aplicar</button>
            </form>
            <div class="btn-group btn-group-sm">
                <a asp-action="Index" asp-route-estado="activos" asp-route-ordenarPor="@ViewBag.OrdenarPor" asp-route-direccion="@ViewBag.Direccion" class="btn btn-outline-secondary">Activos</a>
                <a asp-action="Index" asp-route-estado="inactivos" asp-route-ordenarPor="@ViewBag.OrdenarPor" asp-route-direccion="@ViewBag.Direccion" class="btn btn-outline-secondary">Inactivos</a>
                <a asp-action="Index" asp-route-estado="todos" asp-route-ordenarPor="@ViewBag.OrdenarPor" asp-route-direccion="@ViewBag.Direccion" class="btn btn-outline-secondary">Todos</a>
            </div>
            <span class="text-muted small">Total: @Model.Count()</span>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>ID</th><th>Nombre</th><th>Marca</th><th>Modelo</th><th>Código de barras</th><th>Categoría</th><th>Estado</th><th class="text-end">Precio</th><th class="text-end">Stock mínimo</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="10" class="text-center text-muted py-4">No hay productos registrados.</td></tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.idproducto</td>
                        <td><strong>@item.nombre</strong>@if (!string.IsNullOrWhiteSpace(item.descripcion)) { <div class="small text-muted">@item.descripcion</div> }</td>
                        <td>@(item.marca ?? "—")</td>
                        <td>@(item.modelo ?? "—")</td>
                        <td>@(item.codigo_barras ?? "—")</td>
                        <td>@item.categoria_idcategoriaNavigation.nombre</td>
                        <td><span class="badge @(item.activo ? "text-bg-success" : "text-bg-secondary")">@(item.activo ? "Activo" : "Inactivo")</span></td>
                        <td class="text-end">Bs @item.precio_venta.ToString("N2")</td>
                        <td class="text-end">@(item.stock_minimo?.ToString() ?? "—")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.idproducto" class="btn btn-sm btn-outline-primary">Editar</a>
                            @if (item.activo)
                            {
                                <a asp-action="Delete" asp-route-id="@item.idproducto" class="btn btn-sm btn-outline-warning">Inhabilitar</a>
                            }
                            else
                            {
                                <form asp-action="Reactivar" asp-route-id="@item.idproducto" method="post" class="d-inline"><button type="submit" class="btn btn-sm btn-outline-success">Activar nuevamente</button></form>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
